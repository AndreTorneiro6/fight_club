{
  "name": "fight-club-padel-league",
  "version": "1.6.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "tsx scripts/demo.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:container": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests e2e next.config.ts playwright.config.ts",
    "recovery": "tsx --env-file=.env.local scripts/recovery.ts",
    "notifications:work": "tsx --env-file=.env.local scripts/notifications.ts",
    "notifications:work:container": "tsx scripts/notifications.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.575.0",
    "mongodb": "^7.7.0",
    "next": "16.4.1",
    "nodemailer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
