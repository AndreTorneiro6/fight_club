MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=fight_club
APP_URL=http://localhost:3000
# Explicit admin provisioning: the account registered with this email becomes admin.
# Comma-separated emails that may bootstrap administrator accounts.
ADMIN_EMAIL=admin@yourclub.pt
# SMTP for invitations, recovery and league alerts. Remote SMTP requires TLS.
# Credentials may be in SMTP_URL OR both SMTP_USER/SMTP_PASSWORD (no URL encoding needed).
# Resend: SMTP_URL=smtps://smtp.resend.com:465, SMTP_USER=resend, SMTP_PASSWORD=<sending API key>.
SMTP_URL=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Fight Club Padel League <no-reply@wbglabs.io>
# Optional Google OAuth (callback: APP_URL/api/auth/google-callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Call POST /api/jobs with Authorization: Bearer <secret> from a scheduler
CRON_SECRET=

# WhatsApp Business notifications via Twilio (approved utility template required).
# Template variables: {{1}} event title, {{2}} event details, {{3}} full application link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+YOUR_BUSINESS_NUMBER
TWILIO_WHATSAPP_CONTENT_SID=

# Web Push keys for the player PWA (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourclub.pt

# Optional official Playtomic Third Party API (read-only court occupancy).
# Get credentials in Playtomic Manager > Settings > Developer tools.
PLAYTOMIC_CLIENT_ID=
PLAYTOMIC_CLIENT_SECRET=
PLAYTOMIC_VENUE_ID=

# Production Docker backup target (set this to a mounted USB SSD on the Pi).
BACKUP_PATH=./backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
